{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Lets the Doop desktop shell use IPC from the hosted origin, local development, and the portable localhost server.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://doop.design",
      "https://www.doop.design",
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        }
      ]
    },
    "allow-claude-status",
    "allow-claude-connect",
    "allow-claude-login",
    "allow-claude-install",
    "allow-claude-run",
    "allow-claude-stop"
  ]
}\n